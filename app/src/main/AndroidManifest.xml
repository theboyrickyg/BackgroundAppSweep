<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Runs on phones/tablets AND Android TV / Google TV -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Talks to the device's own debugging service over a local connection -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Setup notification where the phone pairing code is typed -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Needed to show the names and icons of other apps -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Lets AppSweep read each app's cache size (switched on automatically via Shizuku) -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppSweep">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Long-press the phone icon → Quick Sweep -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- One-press sweep. Gets its own tile on the TV home screen. -->
        <activity
            android:name=".QuickSweepActivity"
            android:banner="@drawable/banner_quick"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/quick_sweep"
            android:launchMode="singleTask"
            android:taskAffinity="com.rickyboy.appsweep.quick"
            android:theme="@style/Theme.AppSweep.Quick">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Quick Sweep button in the phone's pull-down panel -->
        <service
            android:name=".SweepTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/quick_sweep"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Easy mode: closes apps by pressing Force stop / Clear cache for you -->
        <service
            android:name=".SweepAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/sweep_accessibility" />
        </service>

        <!-- Receives the pairing code typed into the setup notification -->
        <receiver
            android:name=".PairingReceiver"
            android:exported="false" />

        <!-- Optional: lets the Shizuku app hand its privileged connection to AppSweep -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
