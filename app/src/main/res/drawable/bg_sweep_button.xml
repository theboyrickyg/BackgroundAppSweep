<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient android:angle="0" android:startColor="#FFFF6FB8" android:endColor="#FFC07BFF" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient android:angle="0" android:startColor="@color/neon_pink" android:endColor="@color/neon_purple" />
            <stroke android:width="3dp" android:color="@color/neon_cyan" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient android:angle="0" android:startColor="@color/neon_pink" android:endColor="@color/neon_purple" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
        </shape>
    </item>
</selector>
