<?xml version="1.0" encoding="utf-8"?>
<!-- The "Unlock App Closer" screen, shown after the free cleans are used up -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="22dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="130dp"
            android:adjustViewBounds="true"
            android:contentDescription="App Closer ram"
            android:src="@drawable/all_clean_ram" />

        <TextView
            android:id="@+id/unlockTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:text="UNLOCK APP CLOSER"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/unlockStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/text_main"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="6dp"
            android:text="✓  Close All &amp; Clear Cache, unlimited\n✓  Quick Sweep tile and shortcut\n✓  Stop apps auto-starting\n✓  ⚡ Instant mode: closes everything in seconds\n✓  Works on your phone and TV\n✓  One payment. No subscription, no ads"
            android:textColor="@color/text_main"
            android:textSize="15sp" />

        <Button
            android:id="@+id/unlockBuy"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_sweep_button"
            android:letterSpacing="0.06"
            android:stateListAnimator="@null"
            android:text="UNLOCK · ONE-OFF"
            android:textColor="@color/text_main"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/unlockFree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Free: the RAM gauge and closing apps one at a time with the ✕ keep working."
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <Button
            android:id="@+id/unlockLater"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Not now"
            android:textAllCaps="false"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />

        <Button
            android:id="@+id/unlockRestore"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already bought it? Restore"
            android:textAllCaps="false"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
