<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen card shown during an Easy-mode sweep, so the Settings screens aren't seen -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.15"
            android:text="BACKGROUND APP SWEEP"
            android:textColor="@color/text_main"
            android:textSize="18sp"
            android:textStyle="bold|italic" />

        <com.rickyboy.appsweep.CleanGaugeView
            android:id="@+id/overlayGauge"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="18dp" />

        <TextView
            android:id="@+id/overlayStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:shadowColor="@color/neon_pink"
            android:shadowRadius="10"
            android:text="Sweeping…"
            android:textColor="@color/neon_pink"
            android:textSize="20sp"
            android:textStyle="bold|italic" />

        <TextView
            android:id="@+id/overlayApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_main"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Please don't touch the screen until it's finished"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:textStyle="italic" />
    </LinearLayout>
</FrameLayout>
