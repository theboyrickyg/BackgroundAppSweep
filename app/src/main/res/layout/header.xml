<?xml version="1.0" encoding="utf-8"?>
<!-- Phone: title, two dials side by side, figures underneath -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.15"
        android:text="APP CLOSER"
        android:textColor="@color/text_main"
        android:textSize="17sp"
        android:textStyle="bold|italic" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.rickyboy.appsweep.RamGaugeView
            android:id="@+id/ramGauge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1" />

        <com.rickyboy.appsweep.CleanGaugeView
            android:id="@+id/cleanGauge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

            <TextView
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
                android:id="@+id/ramUsedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:shadowColor="#88FFFFFF"
                android:shadowRadius="8"
                android:text="– GB / – GB"
                android:textColor="@color/text_main"
                android:textSize="24sp"
                android:textStyle="bold|italic" />

            <TextView
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
                android:id="@+id/ramFreeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                android:textStyle="bold|italic" />

            <TextView
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
                android:id="@+id/appsCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Launched apps: –"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                android:textStyle="bold|italic" />
    </LinearLayout>
</LinearLayout>
