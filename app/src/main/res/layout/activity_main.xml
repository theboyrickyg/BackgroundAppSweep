<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp">

    <!-- Top of screen: RAM dial, memory figures, cleaning dial (layout differs on phone vs TV) -->
    <include layout="@layout/header" />

    <LinearLayout
        android:id="@+id/statusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_main"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/statusButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_small_button"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/neon_cyan"
                android:textStyle="bold" />

            <Button
                android:id="@+id/statusButton2"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_small_button"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/neon_cyan"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/codeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/codeInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_small_button"
                android:hint="6-digit pairing code"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="6"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_dim"
                android:textSize="18sp" />

            <Button
                android:id="@+id/pairButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_small_button"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:stateListAnimator="@null"
                android:text="Pair"
                android:textAllCaps="false"
                android:textColor="@color/neon_cyan"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/shizukuButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:background="@android:color/transparent"
            android:stateListAnimator="@null"
            android:text="Already use Shizuku? Use it instead"
            android:textAllCaps="false"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/linkButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_small_button"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/neon_cyan"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp">

        <Button
            android:id="@+id/sweepButton"
            android:layout_width="match_parent"
            android:layout_height="68dp"
                    android:background="@drawable/bg_sweep_button"
            android:enabled="false"
            android:alpha="0.4"
            android:letterSpacing="0.08"
            android:shadowColor="#AA000000"
            android:shadowRadius="6"
            android:stateListAnimator="@null"
            android:text="@string/sweep_button"
            android:textColor="@color/text_main"
            android:textSize="19sp"
            android:textStyle="bold|italic" />

        <!-- Shown for a few seconds after a sweep, in place of the button -->
        <LinearLayout
            android:id="@+id/allCleanView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="170dp"
                android:adjustViewBounds="true"
                android:contentDescription="All clean"
                android:src="@drawable/all_clean_ram" />

            <TextView
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:shadowColor="#FF00E676"
                android:shadowRadius="10"
                android:text="All clean!"
                android:textColor="@color/text_main"
                android:textSize="28sp"
                android:textStyle="bold|italic" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/resultRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_plain"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
                android:id="@+id/statClosed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#00000000"
                android:shadowRadius="0"
                android:text="0"
                android:textColor="@color/text_main"
                android:textSize="20sp"
                android:textStyle="bold|italic" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="APPS CLOSED"
                android:textColor="@color/accent_red"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_plain"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
                android:id="@+id/statRam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#00000000"
                android:shadowRadius="0"
                android:text="0"
                android:textColor="@color/text_main"
                android:textSize="20sp"
                android:textStyle="bold|italic" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="RAM FREED"
                android:textColor="@color/accent_green"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_plain"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
                android:id="@+id/statCache"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#00000000"
                android:shadowRadius="0"
                android:text="0"
                android:textColor="@color/text_main"
                android:textSize="20sp"
                android:textStyle="bold|italic" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="CACHE CLEARED"
                android:textColor="@color/accent_green"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:id="@+id/resultText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/text_dim"
        android:textSize="13sp"
        android:textStyle="italic"
        android:visibility="gone" />

    <TextView
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:id="@+id/statsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="@color/neon_cyan"
        android:textSize="13sp"
        android:textStyle="bold|italic" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/listHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Running apps"
            android:textColor="@color/text_main"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:id="@+id/listHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:text="Biggest RAM users first · Tap an app for options · Hold to close it"
        android:textColor="@color/text_dim"
        android:textSize="12sp"
        android:textStyle="italic" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/appList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />
</LinearLayout>
